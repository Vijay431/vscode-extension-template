{
  "name": "{{EXTENSION_NAME}}",
  "displayName": "{{DISPLAY_NAME}}",
  "description": "{{DESCRIPTION}}",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "{{PUBLISHER}}",
  "icon": "logo.png",
  "author": {
    "name": "{{AUTHOR_NAME}}",
    "email": "{{AUTHOR_EMAIL}}"
  },
  "repository": {
    "type": "git",
    "url": "{{REPO_URL}}.git"
  },
  "bugs": {
    "url": "{{REPO_URL}}/issues"
  },
  "homepage": "{{REPO_URL}}#readme",
  "keywords": [
    "vscode-extension"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "node": ">=24 <25",
    "vscode": ">=1.111.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "{{EXTENSION_ID}}.helloWorld",
        "title": "Hello World",
        "category": "{{DISPLAY_NAME}}"
      },
      {
        "command": "{{EXTENSION_ID}}.enable",
        "title": "Enable",
        "category": "{{DISPLAY_NAME}}"
      },
      {
        "command": "{{EXTENSION_ID}}.disable",
        "title": "Disable",
        "category": "{{DISPLAY_NAME}}"
      },
      {
        "command": "{{EXTENSION_ID}}.showOutputChannel",
        "title": "Show Output Channel",
        "category": "{{DISPLAY_NAME}}"
      }
    ],
    "configuration": {
      "title": "{{DISPLAY_NAME}}",
      "properties": {
        "{{EXTENSION_ID}}.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable {{DISPLAY_NAME}}"
        },
        "{{EXTENSION_ID}}.accessibility.verbosity": {
          "type": "string",
          "enum": [
            "minimal",
            "normal",
            "verbose"
          ],
          "default": "normal",
          "description": "Verbosity of accessibility announcements for screen readers"
        },
        "{{EXTENSION_ID}}.accessibility.screenReaderMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable enhanced screen reader support"
        },
        "{{EXTENSION_ID}}.accessibility.keyboardNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Show keyboard navigation hints in Quick Pick dialogs"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "{{EXTENSION_ID}}.helloWorld",
          "when": "{{EXTENSION_ID}}.enabled"
        },
        {
          "command": "{{EXTENSION_ID}}.enable",
          "when": "!{{EXTENSION_ID}}.enabled"
        },
        {
          "command": "{{EXTENSION_ID}}.disable",
          "when": "{{EXTENSION_ID}}.enabled"
        }
      ]
    }
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "vsce": {
    "dependencies": false,
    "yarn": false
  },
  "ovsx": {
    "namespace": "{{PUBLISHER}}",
    "dependencies": false,
    "yarn": false
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "tsx esbuild.config.ts --production",
    "build": "tsx esbuild.config.ts",
    "watch": "tsx esbuild.config.ts --watch",
    "clean": "rimraf dist *.vsix",
    "rebuild": "pnpm run clean && pnpm run build && vsce package",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:integration": "tsc -p tsconfig.test.json && vscode-test",
    "package": "vsce package",
    "package:openvsx": "ovsx package",
    "publish": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "smoke:bundle": "node scripts/smoke-bundle.cjs",
    "check:prerelease": "node scripts/check-prerelease.cjs",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "biome format --write .",
    "system:verify": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.111.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "all-contributors-cli": "^6.26.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "markdownlint-cli2": "0.23.3",
    "ovsx": "^1.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "5.0.4"
  }
}
